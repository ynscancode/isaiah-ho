---
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { formatPostDate } from '../../lib/eyebrow';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const emptyStatesEntry = await getEntry('site', 'emptyStates');
const emptyStateText = emptyStatesEntry?.data.blog || 'Coming soon.';
---

<SiteLayout title="Blog" description="Writing by Isaiah Ho on structured thinking, case work, and consulting.">
  <SiteHeader />
  <main id="main-content" class="wrap">
    <section class="section section--first" aria-labelledby="blog-h">
      <h1 id="blog-h" class="h-section">Blog</h1>
      {
        posts.length > 0 ? (
          <ul class="posts posts--paper" role="list">
            {posts.map((post) => (
              <li>
                <a class="title u" href={`/blog/${post.id}`}>{post.data.title}</a>
                <span class="when">{formatPostDate(post.data.date)}</span>
                <p class="desc">{post.data.description}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-note">{emptyStateText}</p>
        )
      }
    </section>
  </main>
  <div class="dark floor">
    <div class="wrap"><SiteFooter /></div>
  </div>
</SiteLayout>
