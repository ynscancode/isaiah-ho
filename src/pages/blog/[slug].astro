---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { bodyToHtml } from '../../lib/plainText';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

// Body is stored as plain text, not markdown (product-owner-20260717T170000
// ISSUE B, AC7). bodyToHtml (src/lib/plainText.ts) escapes HTML first, THEN
// wraps blank-line-separated blocks as <p> and single newlines as <br>. The
// set:html string below is built ONLY from this escaped-then-wrapped output
// — the raw body is never passed to set:html directly.
const bodyHtml = bodyToHtml(post.body ?? '');

const dateFormatter = new Intl.DateTimeFormat('en-SG', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<SiteLayout title={post.data.title} description={post.data.description}>
  <SiteHeader />
  <main id="main-content" class="wrap">
    <article class="section section--first">
      <a class="back u" href="/blog"><span aria-hidden="true">&larr;</span> Back to blog</a>
      <p class="page__meta">{dateFormatter.format(post.data.date)}</p>
      {post.data.tags.length > 0 && <p class="page__tags">{post.data.tags.join(', ')}</p>}
      <h1 class="page__title">{post.data.title}</h1>
      <div class="prose" set:html={bodyHtml} />
    </article>
  </main>
  <div class="dark floor">
    <div class="wrap"><SiteFooter /></div>
  </div>
</SiteLayout>
