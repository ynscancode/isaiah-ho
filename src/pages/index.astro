---
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Hero from '../components/site/Hero.astro';
import About from '../components/site/About.astro';
import ExperienceLedger from '../components/site/ExperienceLedger.astro';
import ProjectGrid from '../components/site/ProjectGrid.astro';
import WritingBand from '../components/site/WritingBand.astro';
import Contact from '../components/site/Contact.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { bodyToHtml } from '../lib/plainText';
import { deriveDateRange, formatPostDate } from '../lib/eyebrow';
import { groupByCategory } from '../lib/experienceGroups';
import { parseDetailBullets } from '../lib/detailBullets';
import { isPersistableContactValue } from '../lib/contactValue';

// The page does all collection reads and mapping; site components take plain
// serializable props only.
const homeEntry = await getEntry('site', 'home');
const hero = homeEntry!.data.hero!;
const aboutEntry = await getEntry('site', 'about');
const about = aboutEntry!.data;
const contactEntry = await getEntry('site', 'contact');
const contact = contactEntry!.data;
const emptyStates = (await getEntry('site', 'emptyStates'))?.data;
// KB-0036: category order is explicit data (site.json ordering), never
// collection array order.
const orderingEntry = await getEntry('site', 'ordering');
const categoryOrder = orderingEntry?.data.categoryOrder;

// Contact links: first usable email / linkedin (non-empty and valid).
const links = contact.links ?? [];
const usable = (type: 'email' | 'linkedin') =>
  links.find((l) => l.type === type && l.value !== '' && isPersistableContactValue(l.type, l.value));
const email = usable('email')?.value;
const linkedin = usable('linkedin');
const linkedinUrl = linkedin?.value;
const linkedinLabel = linkedin?.label?.trim() || 'LinkedIn';

// Experience
const experience = await getCollection('experience');
const expGroups = groupByCategory(experience, (e) => e.data.category, categoryOrder?.experience ?? []).map(
  (group) => ({
    category: group.category,
    rows: group.entries.map((e) => ({
      slug: e.data.slug,
      dates: deriveDateRange(e.data.startDate, e.data.endDate),
      title: e.data.title,
      summary: e.data.body,
      bullets: parseDetailBullets(e.data.detail),
    })),
  })
);

// Projects
const projects = await getCollection('projects');
const projectGroups = groupByCategory(projects, (p) => p.data.category, categoryOrder?.projects ?? []).map(
  (group) => ({
    label: group.category,
    cards: group.entries.map((p) => {
      const href = p.data.href?.trim() ? p.data.href : `/projects/${p.data.slug}`;
      return {
        category: group.category,
        dates: deriveDateRange(p.data.startDate, p.data.endDate),
        title: p.data.title,
        body: p.data.body,
        href,
        external: /^https?:\/\//i.test(href),
      };
    }),
  })
);

// Writing: published posts, newest first.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    href: `/blog/${post.id}`,
    title: post.data.title,
    dateLabel: formatPostDate(post.data.date),
  }));
---

<SiteLayout title="Home" description={hero.lede}>
  <SiteHeader home>
    <Hero
      headline={hero.headlineHtml}
      lede={hero.lede}
      email={email}
      linkedinUrl={linkedinUrl}
      linkedinLabel={linkedinLabel}
    />
  </SiteHeader>

  <main id="main-content" class="wrap">
    <About bodyHtml={bodyToHtml(about.body ?? '')} image={about.image} />
    <ExperienceLedger groups={expGroups} emptyText={emptyStates?.experience || 'Coming soon.'} />
    <ProjectGrid groups={projectGroups} emptyText={emptyStates?.projects || 'Coming soon.'} />
  </main>

  <WritingBand posts={posts} emptyText={emptyStates?.blog || 'Coming soon.'} />

  <Contact
    lede={contact.lede ?? ''}
    email={email}
    linkedinUrl={linkedinUrl}
    linkedinLabel={linkedinLabel}
    emptyText={emptyStates?.contact || 'Coming soon.'}
  >
    <SiteFooter />
  </Contact>
</SiteLayout>
