---
// The inline WYSIWYG editor shell — tech-lead-20260715T192159 frontend
// contract, section 5. prerender=false so this can read Astro.locals.session
// (populated by src/middleware.ts) at request time; middleware already
// returns a generic 404 for any /edit/** request without a valid session,
// but this route re-checks defensively so the page itself never assumes it
// was reached legitimately (defense in depth, same generic response either
// way — indistinguishable from a genuinely missing route per KB-0007).
//
// URL scheme:
//   /edit                 -> ONE continuous-scroll page mirroring the public
//                            homepage: hero, About, Experience, Projects,
//                            Writing (blog list), Contact (anchors #about,
//                            #experience, #projects, #writing, #contact)
//   /edit/about|experience|projects|contact|blog
//                         -> 302 to the matching /edit#anchor (old bookmarks;
//                            sits AFTER the session check, so unauthenticated
//                            requests still get the generic 404)
//   /edit/history         -> version history
//   /edit/blog/new        -> create a new post
//   /edit/blog/<slug>     -> edit an existing post
export const prerender = false;

import { loadSiteJson, loadCollectionJson, loadBlogList, loadBlogPost, type ContentSource } from '../../lib/draftContent';
import EditLayout from '../../layouts/EditLayout.astro';
import { isPersistableContactValue } from '../../lib/contactValue';
import EditorHarness from '../../components/EditorHarness.astro';
import EditSite from '../../components/edit/EditSite.astro';
import EditBlogPost from '../../components/edit/EditBlogPost.astro';
import EditHistory from '../../components/edit/EditHistory.astro';

function notFound(): Response {
  return new Response('Not found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

if (!Astro.locals.session) {
  return notFound();
}

const rawPath = Astro.params.path ?? '';
const segments = rawPath.split('/').filter(Boolean);
const [area, sub] = segments;

// Old per-section URLs -> anchors on the single page. Reached only with a
// valid session (checked above); runs before any load.
const LEGACY_ANCHORS: Record<string, string> = {
  about: 'about',
  experience: 'experience',
  projects: 'projects',
  contact: 'contact',
  blog: 'writing',
};
if (segments.length === 1 && Object.hasOwn(LEGACY_ANCHORS, segments[0])) {
  return Astro.redirect('/edit#' + LEGACY_ANCHORS[segments[0]], 302);
}

let pageTitle = 'Edit';
// eslint-disable-next-line @typescript-eslint/no-explicit-any -- discriminated
// by `view`; the branches above are the sole producers, each shaped to match
// the props of the editor component it's handed to below.
let body: any = null;

// The `source` of whichever loader served the current view — draft-then-
// master-then-build (src/lib/draftContent.ts) — surfaced to the toolbar so
// it can render a sync-state affordance (senior-frontend-dev owns that UI;
// this route only supplies the value it already has at render time).
let contentSource: ContentSource;

// tech-lead-20260718T041814 D2: each view loads only the GitHub reads it
// actually needs, concurrently where more than one is needed. Do NOT
// reintroduce an unconditional top-level loadSiteJson() — that was the
// waste (e.g. blog-post views never use siteData/emptyStates).
function emptyStatesFrom(siteData: Record<string, any>) {
  return {
    projects: siteData.emptyStates?.projects ?? '',
    experience: siteData.emptyStates?.experience ?? '',
    blog: siteData.emptyStates?.blog ?? '',
    contact: siteData.emptyStates?.contact ?? '',
    // `highlights` is now a required field on emptyStatesBodySchema
    // alongside the other four (schemas.ts). Every emptyStates-writing
    // editor (Contact/Collection/BlogList) round-trips this WHOLE object on
    // every save regardless of which single field it actually edits — that
    // is the existing convention for the other four fields. Omitting this
    // key here would either fail validation (missing required field) or, if
    // relaxed to optional, silently clobber the highlights empty-state copy
    // back to a default on every unrelated emptyStates save. Must stay a
    // plain string (not the array branch of content.config.ts's union).
    highlights:
      typeof siteData.emptyStates?.highlights === 'string' ? siteData.emptyStates.highlights : '',
  };
}

if (segments.length === 0) {
  // ONE concurrent round of reads for the whole page (D2: load only what is
  // needed). Highlights' pools derive from the SAME results the page edits
  // (KB-0020: reads and writes resolve to the same authority/freshness).
  const [siteJson, projectsResult, experienceResult, blogResult] = await Promise.all([
    loadSiteJson(),
    loadCollectionJson('projects'),
    loadCollectionJson('experience'),
    loadBlogList(),
  ]);
  // WORST source of the four (build > master > draft): if ANY read fell back
  // to GitHub master/build, the whole page renders read-only.
  const SOURCE_RANK: Record<ContentSource, number> = { draft: 0, master: 1, build: 2 };
  contentSource = [siteJson.source, projectsResult.source, experienceResult.source, blogResult.source].reduce(
    (worst, next) => (SOURCE_RANK[next] > SOURCE_RANK[worst] ? next : worst)
  );
  const siteData = (siteJson.data ?? {}) as Record<string, any>;
  const hero = siteData.home?.hero;
  if (!hero || !siteData.about || !siteData.contact) return notFound();
  pageTitle = 'Edit';
  const highlights = Array.isArray(siteData.home?.highlights) ? siteData.home.highlights : [];
  const projectsPool = (projectsResult.data as any[]).map((p) => ({
    slug: p.slug,
    title: p.title,
    category: p.category,
    startDate: p.startDate,
    endDate: p.endDate,
  }));
  // Non-draft only (PO AC1: drafts excluded from the pool).
  const blogPool = blogResult.data
    .filter((p) => !p.draft)
    .map((p) => ({ id: p.slug, title: p.title, date: p.date }));
  // Preview-only pills for the hero (same derivation as src/pages/index.astro:
  // first usable email / LinkedIn contact link). No new load — siteData is in hand.
  const contactLinks: any[] = siteData.contact?.links ?? [];
  const usable = (type: 'email' | 'linkedin') =>
    contactLinks.find((l) => l.type === type && l.value !== '' && isPersistableContactValue(l.type, l.value));
  const linkedin = usable('linkedin');
  const sorted = [...blogResult.data].sort((a, b) => b.date.localeCompare(a.date));
  body = {
    view: 'site',
    hero,
    highlights,
    projectsPool,
    blogPool,
    emptyStates: emptyStatesFrom(siteData),
    actions: {
      email: usable('email')?.value,
      linkedinUrl: linkedin?.value,
      linkedinLabel: linkedin?.label?.trim() || 'LinkedIn',
    },
    about: { body: siteData.about.body ?? '', image: siteData.about.image ?? null },
    experience: experienceResult.data,
    projects: projectsResult.data,
    // KB-0036: order comes from site.json `ordering`, per collection; absent
    // entry reads as [].
    categoryOrder: {
      experience: siteData.ordering?.categoryOrder?.experience ?? [],
      projects: siteData.ordering?.categoryOrder?.projects ?? [],
    },
    posts: sorted.map((p) => ({
      id: p.slug,
      title: p.title,
      description: p.description,
      date: new Date(p.date),
      tags: p.tags,
      draft: p.draft,
    })),
    contact: { lede: siteData.contact.lede ?? '', links: siteData.contact.links ?? [] },
  };
} else if (area === 'history' && !sub) {
  // Version history is fetched client-side from /api/draft/history (see
  // EditHistory.astro) — no server-side draft read needed here, so this
  // route doesn't hit loadSiteJson/loadCollectionJson at all (tech-lead
  // D2: only load what a view actually needs).
  contentSource = 'draft';
  pageTitle = 'Edit — History';
  body = { view: 'history' };
} else if (area === 'blog' && sub === 'new') {
  contentSource = 'draft';
  pageTitle = 'Edit — New blog post';
  body = {
    view: 'blog-post',
    isNew: true,
    post: {
      slug: '',
      title: '',
      description: '',
      date: new Date().toISOString().slice(0, 10),
      draft: true,
      tags: [],
      body: '',
    },
  };
} else if (area === 'blog' && sub) {
  const result = await loadBlogPost(sub);
  contentSource = result.source;
  if (!result.data) return notFound();
  const post = result.data;
  pageTitle = `Edit — ${post.title}`;
  body = {
    view: 'blog-post',
    isNew: false,
    post: {
      slug: post.slug,
      title: post.title,
      description: post.description,
      date: post.date,
      draft: post.draft,
      tags: post.tags,
      body: post.body ?? '',
    },
  };
} else {
  return notFound();
}
---

<EditLayout title={pageTitle} footer={body?.view !== 'site'}>
  {body?.view === 'site' && (
    <EditSite
      hero={body.hero}
      highlights={body.highlights}
      projectsPool={body.projectsPool}
      blogPool={body.blogPool}
      actions={body.actions}
      about={body.about}
      experience={body.experience}
      projects={body.projects}
      categoryOrder={body.categoryOrder}
      posts={body.posts}
      contact={body.contact}
      emptyStates={body.emptyStates}
    />
  )}
  {body?.view === 'blog-post' && <EditBlogPost post={body.post} isNew={body.isNew} />}
  {body?.view === 'history' && <EditHistory />}

  <EditorHarness slot="editor-toolbar" contentSource={contentSource} />
</EditLayout>
