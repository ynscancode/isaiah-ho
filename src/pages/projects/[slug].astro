---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { bodyToHtml } from '../../lib/plainText';
import { deriveEyebrow } from '../../lib/eyebrow';

export async function getStaticPaths() {
  // No draft filter — the projects collection has no `draft` field. Every
  // entry gets a page (tech-lead-20260720T064442 Decision 1): a card must
  // never be a dead link.
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Editor-authored long-form text lives in `detail`; falls back to `body`
// (required, non-empty) so the page is never blank. bodyToHtml
// (src/lib/plainText.ts) is the ONLY thing allowed to feed set:html: it
// escapes HTML first, THEN wraps blocks. The raw string is never passed to
// set:html directly (ARCH-0005 A2 / XSS gate).
const hasDetail = (entry.data.detail ?? '').trim().length > 0;
const bodyHtml = bodyToHtml(hasDetail ? entry.data.detail! : entry.data.body);

const eyebrow = deriveEyebrow(entry.data.category, entry.data.startDate, entry.data.endDate);
---

<SiteLayout title={entry.data.title} description={entry.data.body}>
  <SiteHeader />
  <main id="main-content" class="wrap">
    <article class="section section--first">
      <a class="back u" href="/#projects"><span aria-hidden="true">&larr;</span> Back to projects</a>
      <p class="page__meta">{eyebrow}</p>
      <h1 class="page__title">{entry.data.title}</h1>
      <div class="prose" set:html={bodyHtml} />
      {entry.data.href && (
        <a class="page__link" href={entry.data.href} target="_blank" rel="noopener">View project <span aria-hidden="true">↗</span></a>
      )}
    </article>
  </main>
  <div class="dark floor">
    <div class="wrap"><SiteFooter /></div>
  </div>
</SiteLayout>
