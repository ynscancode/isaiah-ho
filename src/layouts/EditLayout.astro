---
// Shell for every /edit/** page. Deliberately shares NO module with the public
// site: it imports only the global editor sheet (src/styles/editor.css, which
// inlines tokens.css + site.css) so the public build's chunking and compiled
// CSS stay byte-identical. The head mirrors SiteLayout.astro (favicons, fonts)
// — keep them in sync by hand.
import '../styles/editor.css';

export type Props = {
  title: string;
};

const { title } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} · Isaiah Ho</title>
    <meta name="description" content="Isaiah Ho — content editor (private)." />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&display=swap"
    />
  </head>
  <body class="editor-root">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <div class="dark floor">
      <div class="wrap">
        <footer class="site-footer">
          <span>&copy; {year} Isaiah Ho</span>
          <span>Editor</span>
        </footer>
      </div>
    </div>
    <slot name="editor-toolbar" />
  </body>
</html>
