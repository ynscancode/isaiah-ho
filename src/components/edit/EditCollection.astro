---
import EditHeader from './EditHeader.astro';
import EditableExperienceRow from './EditableExperienceRow.astro';
import EditableProjectCard from './EditableProjectCard.astro';
import { groupByCategory } from '../../lib/experienceGroups';

export type CollectionEntry = {
  id: string;
  slug: string;
  category: string;
  startDate: string | null;
  endDate: string | null;
  title: string;
  body: string;
  href?: string;
  detail?: string;
};

export type Props = {
  area: 'projects' | 'experience';
  entries: CollectionEntry[];
  emptyStates: { projects: string; experience: string; blog: string; contact: string };
  /** Canonical persisted category order for THIS area, from site.json's
   * `ordering` entry (tech-lead-20260729T162747). Absent entry reads as []. */
  categoryOrder: string[];
};

const { area, entries, emptyStates, categoryOrder } = Astro.props;
const isExperience = area === 'experience';

// tech-lead-20260720T160424Z Item 3 / ui-ux-designer-20260721T050000Z,
// extended by engineering-director RULING 2 (category-reorder batch,
// 20260729) to ALSO cover the projects branch of THIS editor. Computed once
// here at server render ("load time") from the seed `entries` prop plus the
// canonical persisted `categoryOrder` (site.json `ordering` entry,
// tech-lead-20260729T162747 — the ONE ordering authority; the entries array
// orders nothing but the cards WITHIN a group), NOT reactive to later
// client-side edits (a category contenteditable change re-groups only on the
// next full page load; a category MOVE re-renders client-side instead — see
// the inline script below).
const groups = groupByCategory(entries, (entry) => entry.category, categoryOrder);
const showSubheads = groups.length > 1;
// Reorderable (non-pinned) subset, in display order — used to compute each
// group's Move up/down disabled state (first/last of THIS subset, never the
// pinned "Other" group, which is never a valid move target or destination —
// tech-lead-20260728T224258Z contract 7 invariant).
const reorderableGroups = groups.filter((group) => !group.isPinned);
---

<EditHeader active={area} />
<main id="main-content" class="wrap">
  <section id={area} class="section section--first" aria-labelledby={`${area}-h`}>
    {isExperience ? (
      <h1 id="experience-h" class="h-section">Experience</h1>
    ) : (
      <>
        <div class="projects__head"><h1 id="projects-h" class="h-section">Projects</h1></div>
        <p class="editor-note">Category order here is the filter-chip order on the site; cards show in this order in one grid.</p>
      </>
    )}
    {showSubheads ? (
      <div class={isExperience ? 'exp-groups' : 'editor-groups'} data-editable-area={area} data-collection-list>
        {groups.map((group) => {
          const reorderIndex = reorderableGroups.indexOf(group);
          const isFirstReorderable = reorderIndex === 0;
          const isLastReorderable = reorderIndex === reorderableGroups.length - 1;
          return (
            <div
              class={isExperience ? 'exp-group category-group' : 'category-group'}
              data-category-group={group.isPinned ? undefined : group.category}
              data-pinned-group={group.isPinned ? 'true' : undefined}
            >
              <div class="group-subhead-row">
                <h2 class={isExperience ? 'group-subhead' : 'group-subhead chip'} tabindex="-1">{group.category}</h2>
                {!group.isPinned && (
                  <span class="group-move-controls">
                    <button
                      type="button"
                      class="group-move-btn"
                      data-move-category={group.category}
                      data-move-dir="up"
                      aria-label={`Move ${group.category} up`}
                      disabled={isFirstReorderable}
                    >Move up</button>
                    <button
                      type="button"
                      class="group-move-btn"
                      data-move-category={group.category}
                      data-move-dir="down"
                      aria-label={`Move ${group.category} down`}
                      disabled={isLastReorderable}
                    >Move down</button>
                  </span>
                )}
                {group.isPinned && <span class="editor-note pinned-note">(always last)</span>}
              </div>
              {isExperience
                ? group.entries.map((entry) => (
                    <EditableExperienceRow
                      id={entry.id}
                      category={entry.category}
                      startDate={entry.startDate}
                      endDate={entry.endDate}
                      title={entry.title}
                      body={entry.body}
                      detail={entry.detail}
                      href={entry.href}
                    />
                  ))
                : (
                  <div class="grid">
                    {group.entries.map((entry) => (
                      <EditableProjectCard
                        id={entry.id}
                        category={entry.category}
                        startDate={entry.startDate}
                        endDate={entry.endDate}
                        title={entry.title}
                        body={entry.body}
                        detail={entry.detail}
                        href={entry.href}
                      />
                    ))}
                  </div>
                )}
            </div>
          );
        })}
        {/* ui-ux-designer-20260721T050000Z Item 3.2 — trailing, unlabeled
            "pending" group. New entries created via "+ Add" during this
            session land here (not prematurely bucketed into "Other"); the
            grouping re-reflects on the next full page load. Hidden by CSS
            while empty. */}
        {isExperience ? (
          <div class="exp-group category-group pending-group"><div data-collection-sink /></div>
        ) : (
          <div class="category-group pending-group"><div class="grid" data-collection-sink /></div>
        )}
      </div>
    ) : isExperience ? (
      <div class="exp-groups">
        <div class="exp-group">
          {groups[0] && <h2 class="group-subhead">{groups[0].category}</h2>}
          <div data-editable-area="experience" data-collection-list>
            {entries.map((entry) => (
              <EditableExperienceRow
                id={entry.id}
                category={entry.category}
                startDate={entry.startDate}
                endDate={entry.endDate}
                title={entry.title}
                body={entry.body}
                detail={entry.detail}
                href={entry.href}
              />
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="grid" data-editable-area="projects" data-collection-list>
        {entries.map((entry) => (
          <EditableProjectCard
            id={entry.id}
            category={entry.category}
            startDate={entry.startDate}
            endDate={entry.endDate}
            title={entry.title}
            body={entry.body}
            detail={entry.detail}
            href={entry.href}
          />
        ))}
      </div>
    )}
    <p class="empty-note editor-empty-preview">{emptyStates[area] || 'Coming soon.'}</p>
    <button type="button" class="editor-add-btn" id={`add-${area}-entry`}>+ Add {isExperience ? 'entry' : 'project'}</button>

    <template id={`tpl-${area}-card`}>
      {isExperience ? (
        <EditableExperienceRow id="__ID__" category="" startDate={null} endDate={null} title="" body="" />
      ) : (
        <EditableProjectCard id="__ID__" category="" startDate={null} endDate={null} title="" body="" />
      )}
    </template>

    <div class="editor-field">
      <label class="editor-field-label" for={`empty-state-text-${area}`}>Empty-state message</label>
      <input id={`empty-state-text-${area}`} class="editor-input" type="text" value={emptyStates[area]} data-editable="emptyState" />
      <p class="editor-note">Shown on the public page in place of the list when this section has zero entries.</p>
    </div>
  </section>
</main>

<script define:vars={{ area, entries, emptyStates, categoryOrder }}>
  // define:vars serializes `entries`/`area`/`emptyStates`/`categoryOrder`
  // into this inline script — used only as the initial seed for the
  // in-memory working state, never rendered back into the DOM as raw HTML.
  window.__editorSeed = window.__editorSeed || {};
  window.__editorSeed[area] = entries;
  window.__editorSeed.emptyStates = emptyStates;
  window.__editorSeed.categoryOrder = window.__editorSeed.categoryOrder || {};
  window.__editorSeed.categoryOrder[area] = categoryOrder;
</script>

<script>
  import { makeAutosaver, saveArea, slugify, uniqueId } from '../../lib/editor/client';
  import { commitActive, commitAtomic, register, unregister, wireField } from '../../lib/editor/history';
  import { groupByCategory, normalizeCategoryOrder, reorderCategory } from '../../lib/experienceGroups';

  type Entry = {
    id: string;
    slug: string;
    category: string;
    startDate: string | null;
    endDate: string | null;
    title: string;
    body: string;
    href?: string;
    detail?: string;
  };

  const list = document.querySelector<HTMLElement>('[data-collection-list]');
  const areaAttr = list?.getAttribute('data-editable-area');
  const area = areaAttr === 'projects' || areaAttr === 'experience' ? areaAttr : null;
  // Ungrouped render (projects always; experience when groups.length <= 1):
  // `list` itself is the flat `.cards` grid, so it doubles as the append
  // target. Grouped experience render: `list` is the outer wrapper around
  // all `.category-group`s, and appends must land in the trailing,
  // unlabeled "pending" grid instead (ui-ux-designer-20260721T050000Z item
  // 3.2) — marked `data-collection-sink`.
  const sink = document.querySelector<HTMLElement>('[data-collection-sink]') ?? list;
  if (list && sink && area) {
    // Re-bind to a narrowed const: TS doesn't retain the `area !== null`
    // narrowing for a variable captured by the nested save() closure below.
    const areaName: 'projects' | 'experience' = area;
    // Same narrowing loss as areaName above, but for `sink` — captured by
    // the row controller's undo-of-delete restore closure (Bug 2b) below.
    const sinkEl: HTMLElement = sink;
    const seed = ((window as unknown as { __editorSeed: Record<string, Entry[]> }).__editorSeed?.[areaName] ?? []) as Entry[];
    const working = new Map<string, Entry>(seed.map((entry) => [entry.id, { ...entry }]));

    // --- Canonical category order (tech-lead-20260729T162747 §7) ---
    // The single category accessor, shared by every grouping/ordering call
    // in this file. Declared here because the `workingOrder` init below is
    // its first use.
    function categoryOf(entry: Entry): string {
      return entry.category;
    }

    // Seeded from site.json's `ordering` entry (absent => [], today's live
    // base case) and NORMALIZED here at INIT — before either autosaver is
    // constructed — so `orderAutosaver`'s first snapshot is taken from the
    // already-normalized value. Normalizing later would make init itself
    // look like an edit and could trigger a spurious save (KB-0033).
    const seedOrder = ((window as unknown as {
      __editorSeed: { categoryOrder?: Record<string, string[]> };
    }).__editorSeed?.categoryOrder?.[areaName] ?? []) as string[];
    let workingOrder: string[] = normalizeCategoryOrder(
      Array.from(working.values()),
      categoryOf,
      seedOrder
    );

    const autosaver = makeAutosaver({
      save: () => saveArea(areaName, Array.from(working.values())),
      snapshot: () => JSON.stringify(Array.from(working.values())),
    });

    // Second autosaver, against the separate `categoryOrder` API area —
    // exactly the idiom this file already uses for `emptyStates` below
    // (client.ts documents multiple instances per page). A category Move
    // writes ONLY this area, never the entries, so the "Saved to draft"
    // the owner sees after a Move unambiguously refers to the order write
    // and no partial-failure/false-"Saved" surface exists.
    const orderAutosaver = makeAutosaver({
      save: () => saveArea('categoryOrder', { collection: areaName, order: workingOrder }),
      snapshot: () => JSON.stringify(workingOrder),
    });

    function fieldOf(el: HTMLElement): { id: string; field: keyof Entry } | null {
      const attr = el.getAttribute('data-editable') ?? el.getAttribute('data-editable-href');
      if (!attr) return null;
      const dot = attr.indexOf('.');
      if (dot === -1) return null;
      return { id: attr.slice(0, dot), field: attr.slice(dot + 1) as keyof Entry };
    }

    // --- Bug 3 (senior-frontend-dev-20260721): contenteditable <-> string
    // round-trip helpers. `el.textContent` (the old read) silently drops
    // every `<br>`/`<div>` a real Enter keystroke inserts, so a typed line
    // break never reached `working`/the saved JSON. These two helpers are
    // the ONLY place that translates between the field's DOM shape and the
    // plain-text value stored in `working` — every other read/write in this
    // file goes through them instead of `.textContent`.
    //
    // readEditable: DOM -> string. Text nodes verbatim; a `<br>` becomes
    // `\n` (except a single trailing `<br>` some browsers leave behind
    // after a caret-at-end Enter/backspace, which is dropped rather than
    // producing a phantom trailing blank line); a block child (`<div>`/
    // `<p>` — what Chrome/Firefox wrap subsequent lines in after Enter)
    // starts a new line and recurses so nested text/`<br>`s inside it are
    // read the same way.
    function readEditable(el: HTMLElement): string {
      const children = Array.from(el.childNodes);
      const parts: string[] = [];
      children.forEach((node, index) => {
        if (node.nodeType === Node.TEXT_NODE) {
          parts.push(node.textContent ?? '');
          return;
        }
        if (!(node instanceof HTMLElement)) return;
        if (node.tagName === 'BR') {
          const isLoneTrailing = index === children.length - 1;
          if (!isLoneTrailing) parts.push('\n');
          return;
        }
        if (node.tagName === 'DIV' || node.tagName === 'P') {
          if (parts.length > 0) parts.push('\n');
          parts.push(readEditable(node));
          return;
        }
        parts.push(node.textContent ?? '');
      });
      return parts.join('');
    }

    // writeEditable: string -> DOM. Builds text nodes separated by real
    // `<br>` elements only — no innerHTML / set:html, so a value round-
    // tripped through undo/redo or a save/reload can never be interpreted
    // as markup (KB-0017: the sanitizer-as-affordance lesson from Bug 3's
    // sibling `bodyToHtml` applies here too — this is belt-and-suspenders
    // on the client, the server is still the real trust boundary).
    function writeEditable(el: HTMLElement, value: string): void {
      el.textContent = '';
      const lines = value.split('\n');
      lines.forEach((line, index) => {
        el.appendChild(document.createTextNode(line));
        if (index < lines.length - 1) {
          el.appendChild(document.createElement('br'));
        }
      });
    }

    // Manual caret-position text insertion for the paste handler below —
    // deliberately not `document.execCommand('insertText', ...)` (deprecated,
    // and this file already favors explicit DOM construction over browser
    // command APIs, see writeEditable above).
    function insertTextAtCaret(text: string): void {
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0) return;
      const range = selection.getRangeAt(0);
      range.deleteContents();
      const node = document.createTextNode(text);
      range.insertNode(node);
      range.setStartAfter(node);
      range.setEndAfter(node);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    const template = document.getElementById(`tpl-${area}-card`) as HTMLTemplateElement | null;

    // Bug 2b: shared "build an empty card DOM node from the <template>"
    // logic — used by both the "+ Add" handler and the row controller's
    // undo-of-delete restore path below, so the two ways a card can be
    // (re)created never drift apart.
    function buildSlotFromTemplate(id: string): HTMLElement | null {
      if (!template) return null;
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const html = fragment.querySelector('.card-slot')!.outerHTML.split('__ID__').join(id);
      const wrapper = document.createElement('div');
      wrapper.innerHTML = html;
      return wrapper.firstElementChild as HTMLElement;
    }

    // Bug 2b: populate a freshly-built (empty-field) slot's editable DOM
    // from a restored `entry` — the "+ Add" path never needs this (it seeds
    // a genuinely empty entry, product-owner-20260717T200000 Decision 4),
    // but restoring a deleted entry has real values to write back in.
    function populateSlotFields(slot: HTMLElement, entry: Entry): void {
      slot.querySelectorAll<HTMLElement>('[contenteditable="true"][data-editable]').forEach((el) => {
        const target = fieldOf(el);
        if (!target) return;
        const value = (entry as unknown as Record<string, unknown>)[target.field];
        writeEditable(el, typeof value === 'string' ? value : '');
      });
      slot.querySelectorAll<HTMLInputElement>('input[type="date"][data-editable]').forEach((el) => {
        const target = fieldOf(el);
        if (!target) return;
        const value = (entry as unknown as Record<string, unknown>)[target.field];
        el.value = typeof value === 'string' ? value : '';
      });
      const hrefValueEl = slot.querySelector('[data-editable-href-value]');
      if (hrefValueEl) hrefValueEl.textContent = entry.href && entry.href.length > 0 ? entry.href : '(none)';
    }

    function wireSlot(slot: HTMLElement) {
      const entryId = slot.getAttribute('data-entry-id');
      const historyIds: string[] = [];

      // Bug 2b: structural delete/undo controller — models "this card
      // exists in `working` and the DOM" as its own history step, distinct
      // from any single field's value, using the EXISTING commitAtomic/
      // register/undo/redo machinery (ZERO changes to history.ts's stack
      // logic). Registered on every wireSlot() call (including a restore)
      // and — unlike the field controllers below — deliberately NEVER
      // unregistered by the delete handler: history.ts already makes
      // undo/redo of an unregistered id a documented no-op, so unregistering
      // this one would make a deletion permanently un-undoable.
      if (entryId) {
        const rowId = `${areaName}:${entryId}.__row__`;
        register({
          id: rowId,
          read: () => (working.has(entryId) ? JSON.stringify(working.get(entryId)) : ''),
          apply: (value) => {
            if (value === '') {
              // Redo of a delete: remove this card the same way the real
              // delete handler below does, using the field ids THIS
              // wireSlot() call registered (closure `slot`/`historyIds`).
              working.delete(entryId);
              slot.remove();
              historyIds.forEach((historyId) => unregister(historyId));
              unregister(`${areaName}:${entryId}.href`);
              // qa-engineer-20260728T230350 item 3: redo of a delete removes
              // an entry exactly like the real delete handler below, so it
              // needs the same ghost-group prune (see reorderGroupDom).
              reorderGroupDom();
              refreshMoveButtonStates();
              void autosaver.flush(); // undo/redo apply — short-circuits to a status refresh, no save (isApplying())
              return;
            }
            // Undo of a delete: recreate the card exactly like "+ Add"
            // does — rebuild from the <template>, populate its fields with
            // the restored entry, then wireSlot() it so its field
            // controllers (and its own row controller) are re-registered.
            const entry = JSON.parse(value) as Entry;
            working.set(entryId, entry);
            const rebuilt = buildSlotFromTemplate(entryId);
            if (!rebuilt) return;
            // Restored card lands in `sink` — same placement "+ Add" uses,
            // not its original category group (grouping is load-time only,
            // tech-lead-20260721T154444 Bug 2b note / USER DECISION 1).
            sinkEl.appendChild(rebuilt);
            populateSlotFields(rebuilt, entry);
            wireSlot(rebuilt);
            void autosaver.flush(); // undo/redo apply — short-circuits, no save (isApplying())
          },
        });
      }

      // contenteditable text fields (category/title/body/detail)
      slot.querySelectorAll<HTMLElement>('[contenteditable="true"][data-editable]').forEach((el) => {
        const target = fieldOf(el);
        // Bug-3 single-line policy: category (the inline eyebrow) and title
        // are rendered single-line (group subhead / heading) — a newline is
        // meaningless there, so Enter is suppressed and a paste's newlines
        // collapse to spaces. body/detail stay multi-line (they round-trip
        // through bodyToHtml on the public detail pages).
        const singleLine = target?.field === 'category' || target?.field === 'title';

        // Bug A fix (tech-lead-20260721T211746): server-rendered initial
        // value is a raw text node containing literal `\n` (from
        // Card.astro), which the browser visually collapses. Normalize it
        // through the same readEditable/writeEditable round-trip used at
        // runtime so load-state DOM matches edit-state DOM (real `<br>`s).
        // Guard on includes('\n') — writeEditable(el, '') would append an
        // empty text node and defeat the :empty::before placeholder for
        // empty body/detail fields.
        if (!singleLine && target) {
          const initial = readEditable(el);
          if (initial.includes('\n')) writeEditable(el, initial);
        }

        if (singleLine) {
          el.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') event.preventDefault();
          });
          el.addEventListener('paste', (event) => {
            event.preventDefault();
            const text = (event.clipboardData?.getData('text/plain') ?? '').replace(/\r?\n+/g, ' ');
            insertTextAtCaret(text);
            el.dispatchEvent(new Event('input', { bubbles: true }));
          });
        }

        el.addEventListener('input', () => {
          // Some browsers leave a stray <br> behind after a full delete,
          // which would silently defeat the :empty::before CSS hint
          // (ui-ux-designer-20260717T210000 section 6 implementation note).
          if (el.textContent === '' && el.innerHTML !== '') {
            el.innerHTML = '';
          }
          if (!target) return;
          const entry = working.get(target.id);
          if (!entry) return;
          (entry as unknown as Record<string, unknown>)[target.field] = readEditable(el);
          autosaver.markDirty();
        });

        if (target) {
          const historyId = `${areaName}:${target.id}.${target.field}`;
          historyIds.push(historyId);
          wireField({
            id: historyId,
            el,
            getValue: () => readEditable(el),
            setValue: (value) => {
              writeEditable(el, value);
            },
            onApply: (value) => {
              const entry = working.get(target.id);
              if (entry) (entry as unknown as Record<string, unknown>)[target.field] = value;
              if (target.field === 'category') {
                // Same ghost-group prune as delete (KB-0033 mirror case,
                // qa-engineer-20260728T230350 item 3): undo/redo of a
                // category edit can empty out — or refill — a group's live
                // entry count just like a live edit can.
                reorderGroupDom();
                refreshMoveButtonStates();
              }
              void autosaver.flush(); // undo/redo apply
            },
          });
        }

        // commit(historyId) (wireField's own blur listener above) runs
        // first; this second blur listener (registered after) fires next
        // and performs the actual git-commit flush.
        el.addEventListener('blur', () => {
          void autosaver.flushIfDirty();
          if (target?.field === 'category') {
            // qa-engineer-20260728T230350 item 3, "or recategorized" half:
            // retyping an entry's category away from its group can empty
            // that group out exactly like a delete can. Prune the resulting
            // ghost wrapper and recompute the remaining groups' disabled
            // states. Deliberately does NOT create/move a wrapper for the
            // entry's NEW category — full live regrouping stays "next full
            // page load only" by this file's existing design (see
            // reorderGroupDom's comment).
            reorderGroupDom();
            refreshMoveButtonStates();
          }
        });
      });

      // native date pickers (startDate/endDate)
      slot.querySelectorAll<HTMLInputElement>('input[type="date"][data-editable]').forEach((el) => {
        el.addEventListener('input', () => {
          const target = fieldOf(el);
          if (!target) return;
          const entry = working.get(target.id);
          if (!entry) return;
          (entry as unknown as Record<string, unknown>)[target.field] = el.value.length > 0 ? el.value : null;
          autosaver.markDirty();
        });

        const target = fieldOf(el);
        if (target) {
          const historyId = `${areaName}:${target.id}.${target.field}`;
          historyIds.push(historyId);
          wireField({
            id: historyId,
            el,
            getValue: () => el.value,
            setValue: (value) => {
              el.value = value;
            },
            onApply: (value) => {
              const entry = working.get(target.id);
              if (entry) (entry as unknown as Record<string, unknown>)[target.field] = value.length > 0 ? value : null;
              void autosaver.flush(); // undo/redo apply
            },
          });
        }

        // commit(historyId) (wireField's own blur listener above) runs
        // first; this second blur listener (registered after) fires next.
        el.addEventListener('blur', () => {
          void autosaver.flushIfDirty();
        });
      });

      slot.querySelectorAll<HTMLButtonElement>('[data-editable-href]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = fieldOf(btn);
          if (!target) return;
          const entry = working.get(target.id);
          if (!entry) return;
          const current = entry.href ?? '';
          const next = window.prompt('Edit link URL (leave blank for none):', current);
          if (next === null) return;
          const value = next.trim();
          entry.href = value.length > 0 ? value : undefined;
          const valueEl = slot.querySelector('[data-editable-href-value]');
          if (valueEl) valueEl.textContent = value.length > 0 ? value : '(none)';
          void autosaver.flush(); // prompt confirm — discrete commit

          const historyId = `${areaName}:${target.id}.href`;
          register({
            id: historyId,
            read: () => working.get(target.id)?.href ?? '',
            apply: (v) => {
              const e = working.get(target.id);
              if (e) e.href = v.length > 0 ? v : undefined;
              const vEl = slot.querySelector('[data-editable-href-value]');
              if (vEl) vEl.textContent = v.length > 0 ? v : '(none)';
              void autosaver.flush(); // undo/redo apply
            },
          });
          commitAtomic(historyId, current, value);
        });
      });

      const removeBtn = slot.querySelector<HTMLButtonElement>('[data-remove-entry]');
      removeBtn?.addEventListener('click', () => {
        const id = removeBtn.getAttribute('data-remove-entry');
        if (!id) return;
        if (!window.confirm('Remove this entry? It will be deleted from the draft on next save.')) return;
        // Bug 2b: capture the pre-delete entry BEFORE removing it, so the
        // structural row controller registered above can restore it on
        // undo. Real (non-applying) delete — this is the ONLY place a
        // deletion's git-save actually happens (the discrete flush below);
        // the row controller's own apply() only ever runs during undo()/
        // redo(), which short-circuit that same flush() via isApplying().
        const serialized = JSON.stringify(working.get(id));
        working.delete(id);
        slot.remove();
        historyIds.forEach((historyId) => unregister(historyId));
        unregister(`${areaName}:${id}.href`);
        // qa-engineer-20260728T230350 item 3 fix: a delete can empty out
        // the entry's category group — prune the resulting ghost wrapper
        // (header + Move buttons) and recompute the remaining groups'
        // boundary disabled states (removing a group can change which one
        // is now first/last of the reorderable set).
        reorderGroupDom();
        refreshMoveButtonStates();
        commitAtomic(`${areaName}:${id}.__row__`, serialized, '');
        void autosaver.flush(); // deletion — discrete commit
      });
    }

    list.querySelectorAll<HTMLElement>('.card-slot').forEach(wireSlot);

    const addBtn = document.getElementById(`add-${area}-entry`);
    addBtn?.addEventListener('click', () => {
      const id = uniqueId();
      const slot = buildSlotFromTemplate(id);
      if (!slot) return;
      // `addBtn` is a sibling of `list` (or, when grouped, of the outer
      // wrapper) — append to `sink` (the flat grid, or the trailing
      // "pending" grid when grouped) rather than insertBefore(addBtn).
      sink.appendChild(slot);

      // Truly empty seed (product-owner-20260717T200000 Decision 4) —
      // category/title/body start as empty strings (shown via the
      // :empty::before CSS hint, never a literal placeholder string the
      // user has to delete). `slug` is not a user-facing field here, so it
      // is auto-derived from the entry id (invisible, schema-valid) rather
      // than left empty, which would fail the server's slug min-length
      // validation on save.
      const newEntry: Entry = {
        id,
        slug: slugify(`entry-${id}`),
        category: '',
        startDate: null,
        endDate: null,
        title: '',
        body: '',
        detail: '',
      };
      working.set(id, newEntry);
      wireSlot(slot);
      void autosaver.flush(); // add-entry click — discrete commit

      const categoryEl = slot.querySelector<HTMLElement>('[data-editable$=".category"]');
      categoryEl?.focus();
    });

    // --- Category-group reorder (tech-lead-20260729T162747 RATIFIED /
    // ui-ux-designer-20260729T193000 spec / engineering-director RULINGs
    // 1-3) ---
    // EXPLICIT persisted-order model: a category Move mutates `workingOrder`
    // (the canonical list, persisted to site.json's `ordering` entry through
    // `orderAutosaver`) via the pure `reorderCategory` helper, and does NOT
    // touch the entries at all. The run-1 implicit model — permuting
    // `working`'s insertion order — was write-only w.r.t. the public site
    // (KB-0036/KB-0020) and is gone.
    // `list` here doubles as the grouped wrapper (`.collection-groups`)
    // when `showSubheads` was true at render time; on the ungrouped render
    // (projects/experience with <=1 category) it has no `.group-move-btn`
    // descendants, so all of the wiring below is a no-op — safe either way.
    const pendingGroupEl = document.querySelector<HTMLElement>('.category-group.pending-group');
    // (`categoryOf` is declared up with the `workingOrder` init above, which
    // is its first use — no reliance on function-declaration hoisting.)

    // Re-derive groups from the CURRENT live entries AND the current
    // `workingOrder` (not the load-time server-rendered `groups`), so a
    // move's effect on category order is always computed from the same
    // authority the render and the save use, at the same freshness
    // (KB-0020 — the run-1 blocker was exactly a divergence here).
    function liveGroups() {
      return groupByCategory(Array.from(working.values()), categoryOf, workingOrder);
    }

    // Reposition the EXISTING `.category-group` wrapper elements (built at
    // server render time) to match `liveGroups()`'s new order — never
    // rebuilds card DOM, so in-progress field edits/focus inside a card are
    // untouched by a sibling group's move. The pinned group (if present) is
    // always last among `liveGroups()` by construction (groupByCategory);
    // the trailing "pending" sink is repositioned last of all, always.
    function reorderGroupDom(): void {
      if (!list) return;
      const live = liveGroups();
      // qa-engineer-20260728T230350 item 3 fix, KB-0033 mirror case: a
      // group's `.category-group` wrapper (header + Move buttons) was built
      // ONCE at server-render time and, before this fix, was never removed
      // when its last live entry disappeared — via delete, OR via a
      // category-field edit that empties it out (the "or recategorized"
      // half of the same acceptance item). Prune any wrapper here, in the
      // ONE function that already derives "what does the live DOM structure
      // need to look like" from `liveGroups()`, so every call site
      // (delete, redo-of-delete, category-field commit, and moveCategory
      // itself) shares this single derivation rather than each patching its
      // own copy. Deliberately does NOT create a wrapper for a category
      // that doesn't have one yet (e.g. a brand-new typed category, or a
      // category whose wrapper was already pruned this session) — that
      // would require moving the live card DOM to match, which stays
      // "next full page load only" by this file's existing, documented
      // design (see the `groups` header comment above); recreating a
      // header with no card under it would just be a different-shaped
      // version of the same ghost bug.
      const liveCategories = new Set(live.filter((group) => !group.isPinned).map((group) => group.category));
      const liveHasPinned = live.some((group) => group.isPinned);
      list.querySelectorAll<HTMLElement>('.category-group:not(.pending-group)').forEach((el) => {
        const isPinnedEl = el.getAttribute('data-pinned-group') === 'true';
        const stillLive = isPinnedEl ? liveHasPinned : liveCategories.has(el.getAttribute('data-category-group') ?? '');
        if (stillLive) return;
        // qa-engineer-20260730T070002 defect D1: the wrapper is the PARENT of
        // its `.card-slot`s, so removing it removes whatever is still inside.
        // On the DELETE path the card is already gone (`slot.remove()` ran
        // first), so the wrapper is genuinely empty and removing it is the
        // whole point. On the CATEGORY-RETYPE path it is NOT — the entry is
        // still live and its card is still physically inside the wrapper
        // whose category it just left, so a bare `el.remove()` deleted the
        // card the user had just edited (and detached its history
        // controllers). Relocate any surviving slot into the trailing
        // pending sink FIRST — the same placement "+ Add" and undo-of-delete
        // already use for a card that has no group wrapper to sit under —
        // then prune the now-genuinely-empty wrapper. This keeps the header
        // vanishing (the item-3 fix) without resurrecting a header that has
        // no card under it, which stays "next full page load only" per this
        // function's design note above.
        el.querySelectorAll<HTMLElement>('.card-slot').forEach((slotEl) => {
          sinkEl.appendChild(slotEl);
        });
        el.remove();
      });
      for (const group of live) {
        const selector = group.isPinned
          ? '.category-group[data-pinned-group="true"]'
          : `.category-group[data-category-group="${CSS.escape(group.category)}"]`;
        const el = list.querySelector<HTMLElement>(selector);
        if (el) list.appendChild(el);
      }
      if (pendingGroupEl) list.appendChild(pendingGroupEl);
    }

    // Re-evaluate each reorderable group's Move up/down disabled state
    // against the new order — toggles the EXISTING buttons' `disabled`
    // attribute in place (never recreates them), so a moved group's own
    // buttons keep their element identity for the focus-management step
    // below (ui-ux-designer-20260729T193000 §4).
    function refreshMoveButtonStates(): void {
      if (!list) return;
      const reorderable = liveGroups().filter((group) => !group.isPinned);
      reorderable.forEach((group, index) => {
        const upBtn = list.querySelector<HTMLButtonElement>(
          `.group-move-btn[data-move-category="${CSS.escape(group.category)}"][data-move-dir="up"]`
        );
        const downBtn = list.querySelector<HTMLButtonElement>(
          `.group-move-btn[data-move-category="${CSS.escape(group.category)}"][data-move-dir="down"]`
        );
        if (upBtn) upBtn.disabled = index === 0;
        if (downBtn) downBtn.disabled = index === reorderable.length - 1;
      });
    }

    // Adopt a category order and re-render the group DOM to match. The
    // run-1 `applyOrder(ids)` (which permuted `working`'s insertion order
    // and needed its own two-way entry-id fail-soft) is gone: `working`'s
    // key order no longer carries ordering meaning at all, and the
    // fail-soft now lives structurally in `groupByCategory`'s partition —
    // a name with no live group renders nothing, a live category the list
    // omits renders last. Used by both a live Move and undo/redo apply.
    function applyCategoryOrder(order: string[]): void {
      workingOrder = order;
      reorderGroupDom();
      refreshMoveButtonStates();
    }

    // Focus management after a move (ui-ux-designer-20260729T193000 §4):
    // same button if still enabled -> other direction's button on the same
    // group if enabled -> that group's own (tabindex="-1") heading -> never
    // silently dropped.
    function focusAfterMove(category: string, dir: 'up' | 'down'): void {
      if (!list) return;
      const sameBtn = list.querySelector<HTMLButtonElement>(
        `.group-move-btn[data-move-category="${CSS.escape(category)}"][data-move-dir="${dir}"]`
      );
      if (sameBtn && !sameBtn.disabled) {
        sameBtn.focus();
        return;
      }
      const otherDir = dir === 'up' ? 'down' : 'up';
      const otherBtn = list.querySelector<HTMLButtonElement>(
        `.group-move-btn[data-move-category="${CSS.escape(category)}"][data-move-dir="${otherDir}"]`
      );
      if (otherBtn && !otherBtn.disabled) {
        otherBtn.focus();
        return;
      }
      const heading = list.querySelector<HTMLElement>(
        `.category-group[data-category-group="${CSS.escape(category)}"] .group-subhead`
      );
      heading?.focus();
    }

    function moveCategory(category: string, direction: -1 | 1): void {
      commitActive(); // KB-0032 — commit any pending field edit before acting
      const before = JSON.stringify(workingOrder);
      // `reorderCategory` returns the new ORDER LIST, derived from the live
      // entries — so the written value is self-pruning (names with no live
      // entries drop out) and self-healing (live-but-unlisted categories
      // are appended). This is the write-time prune; correctness never
      // depends on it (tech-lead-20260729T162747 §4).
      applyCategoryOrder(
        reorderCategory(Array.from(working.values()), categoryOf, workingOrder, category, direction)
      );
      const after = JSON.stringify(workingOrder);
      commitAtomic(`${areaName}:__order__`, before, after);
      void orderAutosaver.flush(); // discrete commit, same idiom as add/remove
      focusAfterMove(category, direction === -1 ? 'up' : 'down');
    }

    list.querySelectorAll<HTMLButtonElement>('.group-move-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const category = btn.getAttribute('data-move-category');
        const dir = btn.getAttribute('data-move-dir');
        if (!category || (dir !== 'up' && dir !== 'down')) return;
        moveCategory(category, dir === 'up' ? -1 : 1);
      });
    });

    // Structural per-area history controller (tech-lead-20260729T162747 §7
    // — RE-POINTED, not rebuilt: same id, same registration discipline;
    // only its VALUE changed, from an entry-id permutation to the category
    // ORDER LIST). Same family as the `__row__` row controllers above: ONE
    // controller per area, registered ONCE here at init, NEVER unregistered.
    // `register()` seeds `lastValue` from `read()` at call time (KB-0033 —
    // normalizing/registering at init must not itself mark the area dirty;
    // it doesn't, since `register()` only reads, never calls `markDirty`/
    // `flush`, and `workingOrder` was normalized above BEFORE the autosavers
    // were constructed). No dot in the id, so it can never collide with the
    // `${areaName}:${entryId}.${field}` field-controller id shape.
    // An undo can restore a category NAME that has since been renamed away;
    // harmless — such a name has no rendering path (drift case c).
    register({
      id: `${areaName}:__order__`,
      read: () => JSON.stringify(workingOrder),
      apply: (value) => {
        applyCategoryOrder(JSON.parse(value) as string[]);
        void orderAutosaver.flush(); // undo/redo apply — short-circuits to a status refresh, no save (isApplying())
      },
    });

    window.addEventListener('editor:save-all', () => {
      void autosaver.flush();
      void orderAutosaver.flush();
    });
  }

  // --- Empty-state message (product-owner-20260717T200000 Decision 3) ---
  if (area) {
    const areaName: 'projects' | 'experience' = area;
    const emptyStateEl = document.getElementById(`empty-state-text-${areaName}`) as HTMLInputElement | null;
    if (emptyStateEl) {
      const seedEmptyStates = (
        window as unknown as { __editorSeed: { emptyStates?: { projects: string; experience: string; blog: string; contact: string } } }
      ).__editorSeed.emptyStates ?? { projects: '', experience: '', blog: '', contact: '' };
      const workingEmptyStates = { ...seedEmptyStates };

      const emptyStatesAutosaver = makeAutosaver({
        save: () => saveArea('emptyStates', workingEmptyStates),
        snapshot: () => JSON.stringify(workingEmptyStates),
      });

      emptyStateEl.addEventListener('input', () => {
        workingEmptyStates[areaName] = emptyStateEl.value;
        emptyStatesAutosaver.markDirty();
      });

      wireField({
        id: `${areaName}:emptyState`,
        el: emptyStateEl,
        getValue: () => emptyStateEl.value,
        setValue: (value) => {
          emptyStateEl.value = value;
        },
        onApply: (value) => {
          workingEmptyStates[areaName] = value;
          void emptyStatesAutosaver.flush(); // undo/redo apply
        },
      });

      // commit(historyId) (wireField's own blur listener above) runs first;
      // this second blur listener (registered after) fires next.
      emptyStateEl.addEventListener('blur', () => {
        void emptyStatesAutosaver.flushIfDirty();
      });

      window.addEventListener('editor:save-all', () => {
        void emptyStatesAutosaver.flush();
      });
    }
  }
</script>
