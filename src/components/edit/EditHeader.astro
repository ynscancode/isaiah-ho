---
// Mirrors src/components/site/SiteHeader.astro — keep class structure in sync.
// Oxblood header ground with editor-section anchors; the default slot renders
// inside the same floor/wrap (the home editor puts the hero there).
export type Props = {
  /** On the combined /edit page links are in-page anchors (as SiteHeader's
   * `home`); on the separate pages (blog post, history) they point back to
   * `/edit#...`. */
  home?: boolean;
  /** Marks the History link as the current page. */
  current?: 'history';
};

const { home = false, current } = Astro.props;
const base = home ? '' : '/edit';
// Same ids as the public page / SiteHeader.
const links = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'contact', label: 'Contact' },
];
---

<div class="dark floor" id="top">
  <div class="wrap">
    <header class="site-header">
      <a class="wordmark u" href={home ? '#top' : '/edit'}>Isaiah Ho</a>
      <nav class="nav" aria-label="Editor sections">
        {links.map((link) => <a class="u" href={`${base}#${link.id}`}>{link.label}</a>)}
        <a class="u" href="/edit/history" aria-current={current === 'history' ? 'page' : undefined}>History</a>
      </nav>
    </header>
    <slot />
  </div>
</div>
